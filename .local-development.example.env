# Local development setup
# Copy this file to .local-development.env and adjust the values.

# Network interface used for the local n8n webhook endpoint.
# Examples:
# Windows: Ethernet, Wi-Fi
# Linux: tun0, eth0, enp0s3
# macOS: utun3
LOCAL_N8N_INTERFACE=

# Optional IPv4 prefix used to find the correct address.
# Example: 192.168.1.
LOCAL_N8N_SUBNET=

# Optional explicit IPv4 address.
# Takes precedence over interface and subnet selection.
LOCAL_N8N_IP=

# Local HTTPS port used by n8n.
LOCAL_N8N_PORT=5678

# Validity period of the generated self-signed certificate.
LOCAL_N8N_CERT_VALIDITY_DAYS=365

# Optional path to the OpenSSL executable.
# Leave empty to use OpenSSL from PATH.
LOCAL_N8N_OPENSSL_PATH=

# Additional n8n environment variables
# The setup script owns the following keys and always derives them from the
# values above, so setting them here has no effect:
#   N8N_SECURE_COOKIE, N8N_LISTEN_ADDRESS, N8N_HOST, N8N_PORT, N8N_PROTOCOL,
#   N8N_WEBHOOK_URL, N8N_SSL_CERT, N8N_SSL_KEY
# Every other variable starting with N8N_ is appended to the generated
# .env.local file. Variables left empty are skipped.

# Allow unverified community packages in the local development environment.
N8N_UNVERIFIED_PACKAGES_ENABLED=true

# Optional project-specific n8n user folder.
# Leave empty to use the default n8n user folder.
# Example Windows:
# N8N_USER_FOLDER=C:\Users\YourName\n8n-development
# Example Linux/macOS:
# N8N_USER_FOLDER=/home/yourname/n8n-development
N8N_USER_FOLDER=

# Optional additional settings:
# N8N_LOG_LEVEL=debug
# N8N_RUNNERS_TASK_TIMEOUT=300
